{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zoffline-launcher",
  "version": "1.0.3",
  "identifier": "com.zoffline.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "zoffline 启动器",
        "width": 960,
        "height": 680,
        "minWidth": 860,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxNTU1MjMzODM2Q0IxNUEKUldSYXNXeURNMUpWMFhsY1FQaEFuUlcwMHZVdm1jelpiYlhhQmdyU1VhRzI1WWY0Q3BuaVVwSksK",
      "endpoints": [
        "https://ghfast.top/https://github.com/Lu-QQ/zwift-offline-app/releases/latest/download/latest.json",
        "https://gh-proxy.com/https://github.com/Lu-QQ/zwift-offline-app/releases/latest/download/latest.json",
        "https://github.com/Lu-QQ/zwift-offline-app/releases/latest/download/latest.json"
      ]
    }
  }
}
